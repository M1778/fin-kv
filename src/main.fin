// fin-kv: single-process, bounded, loopback TCP store (Linux/POSIX).
// Strings in Store are owned; Parsed and Reply own their strings (error is borrowed).
// AOF records are committed before map mutation. See README for failure semantics.
import { len, equals, concat, substr, from_chars, to_chars, to_upper, clone, free_str, starts_with } from strings::std;
import { now } from time::std;
import { hash_of } from hashmap::std;

#c_ifdef FIN_TARGET_WINDOWS
pub type KVSocket = ulong;
type KVSocketSize = int;
type KVSocketCount = int;
#c_else
pub type KVSocket = int;
type KVSocketSize = ulong;
type KVSocketCount = long;
#c_endif

#[llvm_name="setvbuf"] @define kv_setvbuf(fp: &void, buf: &char, mode: int, size: ulong) <int>;
#[llvm_name="fwrite"] @define kv_fwrite(buf: string, size: ulong, count: ulong, fp: &void) <ulong>;
#[llvm_name="fflush"] @define kv_fflush(fp: &void) <int>;
#[llvm_name="fclose"] @define kv_fclose(fp: &void) <int>;
#[llvm_name="getenv"] @define kv_getenv(name: string) <string>;

#c_ifdef FIN_TARGET_WINDOWS
#[llvm_name="_close"] @define kv_close(fd: int) <int>;
#[llvm_name="_fdopen"] @define kv_fdopen(fd: int, mode: string) <&void>;
#[llvm_name="_commit"] @define kv_fsync(fd: int) <int>;
#[llvm_name="_chsize_s"] @define kv_truncate(fd: int, size: long) <int>;
#[llvm_name="_lseeki64"] @define kv_seek(fd: int, offset: long, whence: int) <long>;
#[llvm_name="_read"] @define kv_native_read(fd: int, buf: &char, count: uint) <int>;
#[llvm_name="_errno"] @define kv_errno() <&int>;
#[llvm_name="CreateFileA"] @define kv_create_file(path: string, access: uint, share: uint, security: &void, disposition: uint, flags: uint, template: &void) <long>;
#[llvm_name="GetFileInformationByHandle"] @define kv_file_info(handle: long, info: &char) <int>;
#[llvm_name="GetFileType"] @define kv_file_type(handle: long) <uint>;
#[llvm_name="CloseHandle"] @define kv_close_handle(handle: long) <int>;
#[llvm_name="_open_osfhandle"] @define kv_open_handle(handle: long, flags: int) <int>;
#[llvm_name="_get_osfhandle"] @define kv_get_handle(fd: int) <long>;
#[llvm_name="LockFileEx"] @define kv_lock_file(handle: long, flags: uint, reserved: uint, low: uint, high: uint, overlapped: &void) <int>;
#[llvm_name="GetTickCount64"] @define kv_ticks() <ulong>;
#[llvm_name="WSAStartup"] @define kv_wsa_startup(version: ushort, data: &void) <int>;
#[llvm_name="WSACleanup"] @define kv_wsa_cleanup() <int>;
#[llvm_name="WSAGetLastError"] @define kv_socket_error() <int>;
#[llvm_name="ioctlsocket"] @define kv_ioctl(fd: KVSocket, command: int, argument: &uint) <int>;
#[llvm_name="closesocket"] @define kv_socket_close(fd: KVSocket) <int>;
#[llvm_name="WSAPoll"] @define kv_native_poll(fds: &void, count: uint, timeout: int) <int>;
#c_else
#[llvm_name="uname"] @define kv_uname(buf: &char) <int>;
#[llvm_name="open"] @define kv_open(path: string, flags: int, ...) <int>;
#[llvm_name="close"] @define kv_close(fd: int) <int>;
#[llvm_name="fdopen"] @define kv_fdopen(fd: int, mode: string) <&void>;
#[llvm_name="fsync"] @define kv_fsync(fd: int) <int>;
#[llvm_name="ftruncate"] @define kv_truncate(fd: int, size: long) <int>;
#[llvm_name="flock"] @define kv_native_lock(fd: int, operation: int) <int>;
#[llvm_name="lseek"] @define kv_seek(fd: int, offset: long, whence: int) <long>;
#[llvm_name="read"] @define kv_native_read(fd: int, buf: &char, count: ulong) <long>;
#c_ifdef FIN_TARGET_DARWIN
#[llvm_name="__error"]
#c_else
#[llvm_name="__errno_location"]
#c_endif
@define kv_errno() <&int>;
#[llvm_name="clock_gettime"] @define kv_clock(id: int, ts: &long) <int>;
#[llvm_name="fcntl"] @define kv_fcntl(fd: int, command: int, ...) <int>;
#[llvm_name="close"] @define kv_socket_close(fd: KVSocket) <int>;
#[llvm_name="poll"] @define kv_native_poll(fds: &void, count: ulong, timeout: int) <int>;
#c_ifdef FIN_TARGET_DARWIN
#c_ifdef FIN_TARGET_X86_64
#[llvm_name="fstat$INODE64"]
#c_else
#[llvm_name="fstat"]
#c_endif
#c_else
#[llvm_name="fstat"]
#c_endif
@define kv_native_fstat(fd: int, data: &char) <int>;
#c_endif

#[llvm_name="socket"] @define kv_socket(domain: int, kind: int, protocol: int) <KVSocket>;
#[llvm_name="setsockopt"] @define kv_setsockopt(fd: KVSocket, level: int, option: int, value: &int, size: uint) <int>;
#[llvm_name="inet_addr"] @define kv_inet_addr(host: string) <uint>;
#[llvm_name="bind"] @define kv_bind(fd: KVSocket, addr: &int, size: uint) <int>;
#[llvm_name="listen"] @define kv_listen(fd: KVSocket, backlog: int) <int>;
#[llvm_name="getsockname"] @define kv_sockname(fd: KVSocket, addr: &int, size: &uint) <int>;
#[llvm_name="accept"] @define kv_accept(fd: KVSocket, addr: &int, size: &uint) <KVSocket>;
#[llvm_name="recv"] @define kv_recv(fd: KVSocket, buf: &char, count: KVSocketSize, flags: int) <KVSocketCount>;
#[llvm_name="send"] @define kv_send(fd: KVSocket, buf: &char, count: KVSocketSize, flags: int) <KVSocketCount>;

fun kv_socket_invalid() <KVSocket> { return cast<KVSocket>(-1); }
fun kv_io_interrupted() <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    return kv_socket_error() == 10004;
    #c_else
    return *kv_errno() == 4;
    #c_endif
}
fun kv_io_retry() <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    let code <int> = kv_socket_error();
    return code == 10004 || code == 10035;
    #c_else
    let code <int> = *kv_errno();
    #c_ifdef FIN_TARGET_DARWIN
    return code == 4 || code == 35;
    #c_else
    return code == 4 || code == 11;
    #c_endif
    #c_endif
}
fun kv_network_init() <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    let data <[long]> = new [long, 51]{};
    let status <int> = kv_wsa_startup(cast<ushort>(514), &data[0]);
    let version <int> = cast<int>(cast<ulong>(data[0]) % cast<ulong>(65536));
    delete data;
    if (status != 0) { return false; }
    if (version != 514) { kv_wsa_cleanup(); return false; }
    #c_endif
    return true;
}
fun kv_network_close() <noret> {
    #c_ifdef FIN_TARGET_WINDOWS
    kv_wsa_cleanup();
    #c_endif
}
fun kv_prepare_client(fd: KVSocket) <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    let nonblocking <uint> = cast<uint>(1);
    return kv_ioctl(fd, cast<int>(2147772030), &nonblocking) == 0;
    #c_else
    let flags <int> = kv_fcntl(fd, 3);
    if (flags < 0) { return false; }
    #c_ifdef FIN_TARGET_DARWIN
    let one <int> = 1;
    if (kv_setsockopt(fd, 65535, 4130, &one, cast<uint>(4)) != 0) { return false; }
    return kv_fcntl(fd, 4, flags | 4) == 0;
    #c_else
    return kv_fcntl(fd, 4, flags | 2048) == 0;
    #c_endif
    #c_endif
}
fun kv_send_flags() <int> {
    #c_ifdef FIN_TARGET_WINDOWS
    return 0;
    #c_else
    #c_ifdef FIN_TARGET_DARWIN
    return 0;
    #c_else
    return 16384;
    #c_endif
    #c_endif
}
fun kv_read(fd: int, buffer: &char, count: ulong) <long> {
    #c_ifdef FIN_TARGET_WINDOWS
    return cast<long>(kv_native_read(fd, buffer, cast<uint>(count)));
    #c_else
    return kv_native_read(fd, buffer, count);
    #c_endif
}
fun kv_lock(fd: int) <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    let overlapped <[long]> = new [long, 4]{};
    // Lock a byte beyond any supported log, preserving external read-only inspection.
    overlapped[2] = cast<long>(9223372036854775807);
    let locked <int> = kv_lock_file(kv_get_handle(fd), cast<uint>(3), cast<uint>(0), cast<uint>(1), cast<uint>(0), &overlapped[0]);
    delete overlapped;
    return locked != 0;
    #c_else
    return kv_native_lock(fd, 6) == 0;
    #c_endif
}

const AOF_PATH <string> = "fin-kv.aof";
const MAX_FRAME <int> = 8192;
const MAX_KEY <int> = 256;
const MAX_VALUE <int> = 4096;
const MAX_DEL <int> = 128;
const SLOTS <int> = 16384;
const MAX_KEYS <int> = 8192;
const MAX_BYTES <int> = 33554432;

struct Store { keys <[string]>, values <[string]>, expires <[long]>, states <[int]>, count <int>, bytes <int> }
struct Log { fd <int>, fp <&void>, end <long>, failed <bool> }
struct Number { valid <bool>, value <long> }
// op: 1 PING, 2 SET, 3 GET, 4 DEL, 5 EXISTS, 6 TTL, 7 KEYS, 8 QUIT.
struct Parsed { op <int>, key <string>, value <string>, exp <long>, keys <[string]>, count <int>, error <string> }
struct Reply { text <string>, close <bool> }
struct OpenFlags { valid <bool>, aof <int>, directory <int> }

// Linux UAPI: ARM64 overrides asm-generic/fcntl.h's directory/nofollow bits.
// No O_DIRECT is requested: the x86 O_DIRECTORY bit means O_DIRECT on ARM64.
fun linux_open_flags(machine: string) <OpenFlags> {
    // O_RDWR|O_CREAT|O_APPEND|O_NONBLOCK|O_CLOEXEC is shared by these ABIs.
    const COMMON <int> = 527426;
    if (equals(machine, "x86_64")) {
        return OpenFlags{valid: true, aof: COMMON + 131072, directory: 524288 + 65536};
    }
    if (equals(machine, "aarch64")) {
        return OpenFlags{valid: true, aof: COMMON + 32768, directory: 524288 + 16384};
    }
    return OpenFlags{valid: false, aof: 0, directory: 0};
}
fun detect_open_flags() <OpenFlags> {
    #c_ifdef FIN_TARGET_WINDOWS
    return OpenFlags{valid: true, aof: 32778, directory: 0};
    #c_else
    #c_ifdef FIN_TARGET_DARWIN
    return OpenFlags{valid: true, aof: 16777998, directory: 17826048};
    #c_else
    let invalid <OpenFlags> = OpenFlags{valid: false, aof: 0, directory: 0};
    let info <[char]> = new [char, 390]{};
    if (kv_uname(&info[0]) != 0) { delete info; return invalid; }
    let system_end <int> = 0;
    while (system_end < 65 && info[system_end] != cast<char>(0)) { system_end++; }
    let machine_end <int> = 260;
    while (machine_end < 325 && info[machine_end] != cast<char>(0)) { machine_end++; }
    if (system_end == 65 || machine_end == 325) { delete info; return invalid; }
    let system <string> = from_chars(info, 0, system_end);
    let machine <string> = from_chars(info, 260, machine_end - 260);
    let flags <OpenFlags> = linux_open_flags(machine);
    if (!equals(system, "Linux")) { flags = invalid; }
    free_str(system); free_str(machine); delete info;
    return flags;
    #c_endif
    #c_endif
}
fun kv_open_aof(flags: OpenFlags) <int> {
    #c_ifdef FIN_TARGET_WINDOWS
    // Sharing denies another writer or deletion while this handle is held.
    let handle <long> = kv_create_file(AOF_PATH, cast<uint>(3221225472), cast<uint>(1), null, cast<uint>(4), cast<uint>(2097152), null);
    if (handle == cast<long>(-1)) { return -1; }
    let info <[char]> = new [char, 64]{};
    let valid <bool> = kv_file_info(handle, &info[0]) != 0 && kv_file_type(handle) == cast<uint>(1);
    let attributes <int> = (cast<int>(info[0]) & 255) + (cast<int>(info[1]) & 255) * 256;
    delete info;
    if (!valid || (attributes & 1040) != 0) { kv_close_handle(handle); return -1; }
    let fd <int> = kv_open_handle(handle, flags.aof);
    if (fd < 0) { kv_close_handle(handle); }
    return fd;
    #c_else
    return kv_open(AOF_PATH, flags.aof, 384);
    #c_endif
}
fun kv_regular_file(fd: int) <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    return true;
    #c_else
    let info <[char]> = new [char, 256]{};
    let valid <bool> = kv_native_fstat(fd, &info[0]) == 0;
    #c_ifdef FIN_TARGET_DARWIN
    let at <int> = 4;
    #c_else
    #c_ifdef FIN_TARGET_ARM64
    let at <int> = 16;
    #c_else
    let at <int> = 24;
    #c_endif
    #c_endif
    let mode <int> = (cast<int>(info[at]) & 255) + (cast<int>(info[at + 1]) & 255) * 256;
    delete info;
    return valid && (mode & 61440) == 32768;
    #c_endif
}
fun kv_parent_sync(flags: OpenFlags) <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    // Win32 does not expose directory fsync; only file data is flushed here.
    return true;
    #c_else
    let dir <int> = kv_open(".", flags.directory, 0);
    if (dir < 0) { return false; }
    let synced <int> = kv_fsync(dir);
    let error <int> = *kv_errno();
    let closed <int> = kv_close(dir);
    #c_ifdef FIN_TARGET_DARWIN
    if (synced != 0 && (error == 22 || error == 9)) {
        printf("warning: filesystem does not support directory fsync\n");
        return closed == 0;
    }
    #c_endif
    return synced == 0 && closed == 0;
    #c_endif
}

fun decimal(s: string, maximum: long) <Number> {
    let chars <[char]> = to_chars(s);
    let n <int> = chars.length - 1;
    let value <long> = cast<long>(0);
    let valid <bool> = n > 0;
    for (let i <int> = 0; i < n && valid; i++) {
        let digit <int> = cast<int>(chars[i]) - cast<int>('0');
        if (digit < 0 || digit > 9) { valid = false; }
        else if (value > (maximum - cast<long>(digit)) / cast<long>(10)) { valid = false; }
        else { value = value * cast<long>(10) + cast<long>(digit); }
    }
    delete chars;
    return Number{valid: valid, value: value};
}

fun itoa(n: long) <string> {
    let buf <[char]> = new [char, 24]{};
    let v <long> = n;
    if (v < cast<long>(0)) { v = -v; }
    let i <int> = 23;
    while (true) {
        i--;
        buf[i] = cast<char>(cast<int>(v % cast<long>(10)) + cast<int>('0'));
        v = v / cast<long>(10);
        if (v == cast<long>(0)) { break; }
    }
    if (n < cast<long>(0)) { i--; buf[i] = '-'; }
    let result <string> = from_chars(buf, i, 23 - i);
    delete buf;
    return result;
}

fun reply(text: string) <Reply> { return Reply{text: concat(text, "\n"), close: false}; }
fun error_reply(text: string) <Reply> {
    let msg <string> = concat("(error) ", text);
    let result <Reply> = reply(msg);
    free_str(msg);
    return result;
}
fun integer_reply(value: long) <Reply> {
    let number <string> = itoa(value);
    let msg <string> = concat("(integer) ", number);
    let result <Reply> = reply(msg);
    free_str(number); free_str(msg);
    return result;
}

fun make_store() <Store> {
    return Store{keys: new [string, SLOTS]{}, values: new [string, SLOTS]{}, expires: new [long, SLOTS]{}, states: new [int, SLOTS]{}, count: 0, bytes: 0};
}
// Probe over owned arrays. Tombstone slots are reused without retaining strings.
fun find_slot(store: &Store, key: string) <int> {
    let start <int> = hash_of::<string>(key) % SLOTS;
    let vacant <int> = -1;
    for (let i <int> = 0; i < SLOTS; i++) {
        let at <int> = (start + i) % SLOTS;
        if (store.states[at] == 0) { return vacant >= 0 : vacant ? at; }
        if (store.states[at] == 2 && vacant < 0) { vacant = at; }
        if (store.states[at] == 1 && equals(store.keys[at], key)) { return at; }
    }
    return vacant;
}
fun erase_slot(store: &Store, at: int) <noret> {
    if (at < 0 || store.states[at] != 1) { return; }
    store.bytes -= len(store.keys[at]) + len(store.values[at]);
    free_str(store.keys[at]); free_str(store.values[at]);
    store.keys[at] = ""; store.values[at] = ""; store.expires[at] = cast<long>(0);
    store.states[at] = 2; store.count--;
}
fun expired(store: &Store, at: int) <bool> {
    return at >= 0 && store.states[at] == 1 && store.expires[at] != cast<long>(0) && now() >= store.expires[at];
}
fun lookup(store: &Store, key: string) <int> {
    let at <int> = find_slot(store, key);
    if (expired(store, at)) { erase_slot(store, at); }
    if (at < 0 || store.states[at] != 1) { return -1; }
    return at;
}
fun can_put(store: &Store, key: string, value: string) <bool> {
    let at <int> = find_slot(store, key);
    if (at < 0) { return false; }
    let size <int> = store.bytes + len(key) + len(value);
    if (store.states[at] == 1) { size -= len(store.keys[at]) + len(store.values[at]); }
    else if (store.count >= MAX_KEYS) { return false; }
    return size <= MAX_BYTES;
}
fun put(store: &Store, key: string, value: string, exp: long) <noret> {
    let at <int> = find_slot(store, key);
    // Allocate independent ownership before releasing an old value.
    let owned_key <string> = clone(key);
    let owned_value <string> = clone(value);
    erase_slot(store, at);
    store.keys[at] = owned_key; store.values[at] = owned_value;
    store.expires[at] = exp; store.states[at] = 1;
    store.count++; store.bytes += len(key) + len(value);
}
fun free_store(store: &Store) <noret> {
    for (let i <int> = 0; i < SLOTS; i++) { erase_slot(store, i); }
    delete store.keys; delete store.values; delete store.expires; delete store.states;
}
fun sweep(store: &Store) <noret> {
    for (let i <int> = 0; i < SLOTS; i++) { if (expired(store, i)) { erase_slot(store, i); } }
}

fun space_at(bytes: [char], start: int, n: int) <int> {
    let i <int> = start;
    while (i < n && bytes[i] != ' ') { i++; }
    return i;
}
fun valid_key(key: string) <bool> {
    let bytes <[char]> = to_chars(key);
    let n <int> = bytes.length - 1;
    let valid <bool> = n > 0 && n <= MAX_KEY;
    for (let i <int> = 0; i < n; i++) {
        let c <int> = cast<int>(bytes[i]) & 255;
        if (c <= 32 || c == 127) { valid = false; }
    }
    delete bytes;
    return valid;
}
fun free_parsed(p: &Parsed) <noret> {
    free_str(p.key);
    free_str(p.value);
    for (let i <int> = 0; i < p.count; i++) { free_str(p.keys[i]); }
    delete p.keys;
}
fun parse_set(line: string, bytes: [char], start: int, n: int, replay: bool, p: &Parsed) <noret> {
    let end <int> = space_at(bytes, start, n);
    free_str(p.key);
    p.key = substr(line, start, end - start);
    if (!valid_key(p.key) || end == n) { p.error = "invalid SET key or missing value"; return; }
    let value_start <int> = end + 1;
    let value_end <int> = n;
    if (replay) {
        let exp_end <int> = space_at(bytes, value_start, n);
        let text <string> = substr(line, value_start, exp_end - value_start);
        let number <Number> = decimal(text, cast<long>(9223372036854775807));
        free_str(text);
        if (!number.valid || exp_end - value_start > 19 || exp_end == n) { p.error = "invalid AOF expiry"; return; }
        p.exp = number.value;
        value_start = exp_end + 1;
    } else {
        let last <int> = n - 1;
        while (last >= value_start && bytes[last] != ' ') { last--; }
        let before <int> = last - 1;
        while (before >= value_start && bytes[before] != ' ') { before--; }
        if (last > value_start && before >= value_start) {
            let word <string> = substr(line, before + 1, last - before - 1);
            let upper <string> = to_upper(word);
            let is_ex <bool> = equals(upper, "EX");
            free_str(word); free_str(upper);
            if (is_ex) {
                let seconds <string> = substr(line, last + 1, n - last - 1);
                let number <Number> = decimal(seconds, cast<long>(2147483647));
                free_str(seconds);
                let epoch <long> = now();
                if (!number.valid || number.value == cast<long>(0) || epoch < cast<long>(0) || epoch > cast<long>(9223372036854775807) - number.value) {
                    p.error = "EX must be between 1 and 2147483647 seconds"; return;
                }
                p.exp = epoch + number.value; value_end = before;
            }
        }
        let tail <string> = substr(line, last + 1, n - last - 1);
        let upper_tail <string> = to_upper(tail);
        if (equals(upper_tail, "EX") && last >= value_start) { p.error = "missing EX seconds"; }
        free_str(tail); free_str(upper_tail);
    }
    if (value_end <= value_start || value_end - value_start > MAX_VALUE) { p.error = "invalid value length"; return; }
    free_str(p.value);
    p.value = substr(line, value_start, value_end - value_start);
}
fun parse_line(line: string, replay: bool) <Parsed> {
    let p <Parsed> = Parsed{op: 0, key: clone(""), value: clone(""), exp: cast<long>(0), keys: new [string, MAX_DEL]{}, count: 0, error: ""};
    let bytes <[char]> = to_chars(line);
    let n <int> = bytes.length - 1;
    let end <int> = space_at(bytes, 0, n);
    let word <string> = substr(line, 0, end);
    let command <string> = replay : clone(word) ? to_upper(word);
    free_str(word);
    if (equals(command, "SET")) { p.op = 2; }
    else if (equals(command, "DEL")) { p.op = 4; }
    else if (!replay) {
        if (equals(command, "PING")) { p.op = 1; }
        if (equals(command, "GET")) { p.op = 3; }
        if (equals(command, "EXISTS")) { p.op = 5; }
        if (equals(command, "TTL")) { p.op = 6; }
        if (equals(command, "KEYS")) { p.op = 7; }
        if (equals(command, "QUIT")) { p.op = 8; }
    }
    free_str(command);
    if (p.op == 0) { p.error = "unknown command"; }
    else if (p.op == 1) {
        free_str(p.value);
        p.value = end == n : clone("PONG") ? substr(line, end + 1, n - end - 1);
    } else if (p.op == 8) {
        if (end != n) { p.error = "wrong number of arguments for 'quit'"; }
    } else if (end == n) { p.error = "missing arguments"; }
    else if (p.op == 2) { parse_set(line, bytes, end + 1, n, replay, &p); }
    else if (p.op == 4) {
        let start <int> = end + 1;
        while (start <= n && len(p.error) == 0) {
            let stop <int> = space_at(bytes, start, n);
            let key <string> = substr(line, start, stop - start);
            if (!valid_key(key) || p.count == MAX_DEL) { free_str(key); p.error = "invalid DEL keys"; }
            else { p.keys[p.count] = key; p.count++; }
            start = stop + 1;
        }
    } else {
        free_str(p.key);
        p.key = substr(line, end + 1, n - end - 1);
        if (!valid_key(p.key)) { p.error = "invalid key or argument count"; }
        if (p.op == 7 && !equals(p.key, "*")) { p.error = "only KEYS * is supported"; }
    }
    delete bytes;
    return p;
}

// A tail may be discarded ONLY if it is a prefix of a valid record. Complete
// newline-terminated corruption is never repaired, and no repair happens early.
fun torn_prefix(line: string) <bool> {
    let n <int> = len(line);
    if (equals(line, "S") || equals(line, "SE") || equals(line, "SET") || equals(line, "D") || equals(line, "DE") || equals(line, "DEL")) { return true; }
    let is_set <bool> = starts_with(line, "SET ");
    if (!is_set && !starts_with(line, "DEL ")) { return false; }
    let bytes <[char]> = to_chars(line);
    let start <int> = 4;
    let valid <bool> = true;
    let count <int> = 0;
    while (start < n && valid) {
        let end <int> = space_at(bytes, start, n);
        let key <string> = substr(line, start, end - start);
        valid = valid_key(key);
        free_str(key);
        count++;
        if (count > MAX_DEL) { valid = false; }
        if (!valid || end == n) { break; }
        start = end + 1;
        if (is_set) {
            if (start == n) { break; }
            let stop <int> = space_at(bytes, start, n);
            let exp <string> = substr(line, start, stop - start);
            let number <Number> = decimal(exp, cast<long>(9223372036854775807));
            free_str(exp);
            valid = number.valid && stop - start <= 19;
            if (stop < n && n - stop - 1 > MAX_VALUE) { valid = false; }
            break;
        }
    }
    // After 128 DEL keys, an extra separator cannot begin a valid record.
    if (!is_set && count == MAX_DEL && n > 4 && bytes[n - 1] == ' ') { valid = false; }
    delete bytes;
    return valid;
}
fun replay_line(line: string, store: &Store) <bool> {
    let p <Parsed> = parse_line(line, true);
    let valid <bool> = len(p.error) == 0;
    if (valid && p.op == 2) {
        if (p.exp != cast<long>(0) && now() >= p.exp) { erase_slot(store, find_slot(store, p.key)); }
        else if (!can_put(store, p.key, p.value)) { valid = false; }
        else { put(store, p.key, p.value, p.exp); }
    }
    if (valid && p.op == 4) {
        for (let i <int> = 0; i < p.count; i++) { erase_slot(store, find_slot(store, p.keys[i])); }
    }
    free_parsed(&p);
    return valid;
}
fun replay_aof(log: &Log, store: &Store) <bool> {
    let chunk <[char]> = new [char, 16384]{};
    let line <[char]> = new [char, MAX_FRAME + 1]{};
    let used <int> = 0;
    let offset <long> = cast<long>(0);
    let valid <bool> = true;
    while (valid) {
        let got <long> = kv_read(log.fd, &chunk[0], cast<ulong>(16384));
        if (got < cast<long>(0)) {
            if (*kv_errno() == 4) { continue; }
            valid = false; break;
        }
        if (got == cast<long>(0)) { break; }
        for (let i <int> = 0; i < cast<int>(got) && valid; i++) {
            let c <int> = cast<int>(chunk[i]) & 255;
            offset++;
            if (c == 10) {
                let text <string> = from_chars(line, 0, used);
                valid = replay_line(text, store);
                free_str(text); used = 0;
                if (valid) { log.end = offset; }
            } else if (c < 32 || c == 127 || used == MAX_FRAME) { valid = false; }
            else { line[used] = chunk[i]; used++; }
        }
    }
    if (valid && used > 0) {
        let tail <string> = from_chars(line, 0, used);
        valid = torn_prefix(tail);
        free_str(tail);
        if (valid) {
            valid = kv_truncate(log.fd, log.end) == 0;
            if (valid) { valid = kv_fsync(log.fd) == 0; }
            if (valid) { printf("repaired unterminated AOF tail at %lld\n", log.end); }
        }
    }
    delete chunk; delete line;
    return valid;
}
fun open_log(log: &Log, store: &Store) <bool> {
    let flags <OpenFlags> = detect_open_flags();
    if (!flags.valid) { return false; }
    // Linux O_RDWR|O_CREAT|O_APPEND|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC; mode 0600.
    log.fd = kv_open_aof(flags);
    if (log.fd < 0) { printf("error: cannot open AOF for read/write\n"); return false; }
    if (!kv_regular_file(log.fd)) { printf("error: AOF must be a regular file\n"); return false; }
    if (!kv_lock(log.fd)) { printf("error: AOF already locked\n"); return false; }
    if (kv_seek(log.fd, cast<long>(0), 2) < cast<long>(0) || kv_seek(log.fd, cast<long>(0), 0) != cast<long>(0)) {
        printf("error: AOF must be a seekable file\n"); return false;
    }
    // Do not mix descriptor reads/seeks with a live stdio stream. Replay and
    // any tail repair finish first; only then wrap the append descriptor.
    if (!replay_aof(log, store)) { printf("error: corrupt or unreadable AOF; refusing startup\n"); return false; }
    if (kv_seek(log.fd, cast<long>(0), 2) != log.end) { return false; }
    log.fp = kv_fdopen(log.fd, "a+b");
    if (log.fp == null) { return false; }
    // Unbuffered writes avoid retained stdio bytes escaping after rollback.
    #c_ifdef FIN_TARGET_WINDOWS
    let unbuffered <int> = 4;
    #c_else
    let unbuffered <int> = 2;
    #c_endif
    if (kv_setvbuf(log.fp, null, unbuffered, cast<ulong>(0)) != 0) { return false; }
    // Make creation of the fixed path durable before accepting any requests.
    if (kv_fsync(log.fd) != 0 || !kv_parent_sync(flags)) {
        printf("error: initial AOF durability failed\n"); kv_fflush(null); return false;
    }
    printf("replayed %s: %d live key(s) loaded\n", AOF_PATH, store.count);
    return true;
}
fun close_log(log: &Log) <noret> {
    if (log.fp != null) { kv_fclose(log.fp); }
    else if (log.fd >= 0) { kv_close(log.fd); }
}
fun append_record(log: &Log, record: string) <bool> {
    if (log.failed) { return false; }
    let size <ulong> = cast<ulong>(len(record));
    let wrote <ulong> = kv_fwrite(record, cast<ulong>(1), size, log.fp);
    let flushed <int> = kv_fflush(log.fp);
    let synced <int> = -1;
    if (wrote == size && flushed == 0) { synced = kv_fsync(log.fd); }
    if (wrote != size || flushed != 0 || synced != 0) {
        // A failed durability operation poisons the writer until restart, even
        // when rollback succeeds. No later command may hide this failure.
        log.failed = true;
        let truncated <int> = kv_truncate(log.fd, log.end);
        let restored <int> = kv_fsync(log.fd);
        if (truncated != 0 || restored != 0) { printf("error: AOF rollback durability uncertain\n"); }
        else { printf("error: AOF write failed and was rolled back\n"); }
        kv_fflush(null);
        return false;
    }
    log.end += cast<long>(size);
    return true;
}
fun aof_log_set(log: &Log, p: &Parsed) <bool> {
    let exp <string> = itoa(p.exp);
    let a <string> = concat("SET ", p.key);
    let b <string> = concat(a, " "); free_str(a);
    a = concat(b, exp); free_str(b); free_str(exp);
    b = concat(a, " "); free_str(a);
    a = concat(b, p.value); free_str(b);
    b = concat(a, "\n"); free_str(a);
    let ok <bool> = append_record(log, b);
    free_str(b); return ok;
}
fun aof_log_del(log: &Log, line: string) <bool> {
    let args <string> = substr(line, 4, len(line) - 4);
    let body <string> = concat("DEL ", args);
    let record <string> = concat(body, "\n");
    let ok <bool> = append_record(log, record);
    free_str(args); free_str(body); free_str(record);
    return ok;
}
fun keys_reply(store: &Store) <Reply> {
    sweep(store);
    let number <string> = itoa(cast<long>(store.count));
    let prefix <string> = concat("(keys) ", number);
    let header <string> = concat(prefix, "\n");
    free_str(number); free_str(prefix);
    let total <int> = len(header);
    for (let i <int> = 0; i < SLOTS; i++) { if (store.states[i] == 1) { total += len(store.keys[i]) + 1; } }
    let out <[char]> = new [char, total + 1]{};
    let chars <[char]> = to_chars(header);
    let at <int> = chars.length - 1;
    for (let i <int> = 0; i < at; i++) { out[i] = chars[i]; }
    delete chars; free_str(header);
    for (let i <int> = 0; i < SLOTS; i++) {
        if (store.states[i] == 1) {
            let key <[char]> = to_chars(store.keys[i]);
            for (let j <int> = 0; j < key.length - 1; j++) { out[at] = key[j]; at++; }
            out[at] = '\n'; at++; delete key;
        }
    }
    let result <string> = from_chars(out, 0, at);
    delete out;
    return Reply{text: result, close: false};
}
fun execute(line: string, p: &Parsed, store: &Store, log: &Log) <Reply> {
    if (len(p.error) > 0) { return error_reply(p.error); }
    if (p.op == 1) { return reply(p.value); }
    if (p.op == 8) { return Reply{text: concat("OK", "\n"), close: true}; }
    if (p.op == 2) {
        if (!can_put(store, p.key, p.value)) { return error_reply("store capacity exceeded"); }
        if (!aof_log_set(log, p)) { return error_reply("persistence unavailable; write not applied"); }
        put(store, p.key, p.value, p.exp);
        return reply("OK");
    }
    if (p.op == 4) {
        if (!aof_log_del(log, line)) { return error_reply("persistence unavailable; write not applied"); }
        let count <int> = 0;
        for (let i <int> = 0; i < p.count; i++) {
            let at <int> = lookup(store, p.keys[i]);
            if (at >= 0) { erase_slot(store, at); count++; }
        }
        return integer_reply(cast<long>(count));
    }
    if (p.op == 7) { return keys_reply(store); }
    let at <int> = lookup(store, p.key);
    if (p.op == 3) { return at < 0 : reply("(nil)") ? reply(store.values[at]); }
    if (p.op == 5) { return integer_reply(at < 0 : cast<long>(0) ? cast<long>(1)); }
    if (at < 0) { return integer_reply(cast<long>(-2)); }
    if (store.expires[at] == cast<long>(0)) { return integer_reply(cast<long>(-1)); }
    let left <long> = store.expires[at] - now();
    if (left < cast<long>(0)) { left = cast<long>(0); }
    return integer_reply(left);
}
fun handle_line(line: string, store: &Store, log: &Log) <Reply> {
    if (len(line) == 0) { return reply(""); }
    let p <Parsed> = parse_line(line, false);
    let result <Reply> = execute(line, &p, store, log);
    free_parsed(&p);
    return result;
}

fun monotonic_ms() <long> {
    #c_ifdef FIN_TARGET_WINDOWS
    return cast<long>(kv_ticks());
    #c_else
    let ts <[long]> = new [long, 2]{};
    #c_ifdef FIN_TARGET_DARWIN
    let rc <int> = kv_clock(6, &ts[0]);
    #c_else
    let rc <int> = kv_clock(1, &ts[0]);
    #c_endif
    let result <long> = ts[0] * cast<long>(1000) + ts[1] / cast<long>(1000000);
    delete ts;
    return rc == 0 : result ? cast<long>(-1);
    #c_endif
}
fun wait_socket(fd: KVSocket, events: int, deadline: long) <bool> {
    #c_ifdef FIN_TARGET_WINDOWS
    let fds <[long]> = new [long, 2]{};
    fds[0] = cast<long>(fd);
    let poll_event <long> = cast<long>(16);
    if (events == 1) { poll_event = cast<long>(768); }
    #c_else
    let fds <[int]> = new [int, 2]{};
    fds[0] = fd;
    let poll_event <int> = events;
    #c_endif
    let ready <bool> = false;
    while (true) {
        fds[1] = poll_event;
        let clock <long> = monotonic_ms();
        let left <long> = deadline - clock;
        if (clock < cast<long>(0) || left <= cast<long>(0)) { break; }
        #c_ifdef FIN_TARGET_WINDOWS
        let result <int> = kv_native_poll(&fds[0], cast<uint>(1), cast<int>(left));
        #c_else
        let result <int> = kv_native_poll(&fds[0], cast<ulong>(1), cast<int>(left));
        #c_endif
        if (result > 0) { ready = true; break; }
        if (result == 0 || !kv_io_interrupted()) { break; }
    }
    delete fds;
    return ready;
}
fun send_all(fd: KVSocket, text: string, timeout: int) <bool> {
    let bytes <[char]> = to_chars(text);
    let count <int> = bytes.length - 1;
    let at <int> = 0;
    let deadline <long> = monotonic_ms() + cast<long>(timeout);
    while (at < count && wait_socket(fd, 4, deadline)) {
        let sent <KVSocketCount> = kv_send(fd, &bytes[at], cast<KVSocketSize>(count - at), kv_send_flags());
        if (sent > cast<KVSocketCount>(0)) { at += cast<int>(sent); }
        else if (sent == cast<KVSocketCount>(0) || !kv_io_retry()) { break; }
    }
    delete bytes;
    return at == count;
}
fun serve_client(fd: KVSocket, store: &Store, log: &Log, timeout: int) <noret> {
    let chunk <[char]> = new [char, 4096]{};
    let frame <[char]> = new [char, MAX_FRAME + 1]{};
    let used <int> = 0;
    let alive <bool> = true;
    let deadline <long> = monotonic_ms() + cast<long>(timeout);
    while (alive && wait_socket(fd, 1, deadline)) {
        let got <KVSocketCount> = kv_recv(fd, &chunk[0], cast<KVSocketSize>(4096), 0);
        if (got <= cast<KVSocketCount>(0)) {
            if (got < cast<KVSocketCount>(0) && kv_io_retry()) { continue; }
            break;
        }
        for (let i <int> = 0; i < cast<int>(got) && alive; i++) {
            let c <int> = cast<int>(chunk[i]) & 255;
            if (c == 10) {
                if (used > 0 && frame[used - 1] == '\r') { used--; }
                let line <string> = from_chars(frame, 0, used);
                let result <Reply> = handle_line(line, store, log);
                alive = send_all(fd, result.text, timeout) && !result.close;
                free_str(result.text); free_str(line); used = 0;
                deadline = monotonic_ms() + cast<long>(timeout);
            } else if (c == 0 || (c < 32 && c != 13) || c == 127 || used == MAX_FRAME || (used > 0 && frame[used - 1] == '\r')) {
                send_all(fd, "(error) invalid or oversized frame\n", timeout);
                alive = false;
            } else { frame[used] = chunk[i]; used++; }
        }
    }
    delete chunk; delete frame;
}
fun listen_loopback(port: int, actual: &int) <KVSocket> {
    let fd <KVSocket> = kv_socket(2, 1, 0);
    if (fd == kv_socket_invalid()) { return kv_socket_invalid(); }
    let one <int> = 1;
    #c_ifdef FIN_TARGET_WINDOWS
    let configured <bool> = kv_setsockopt(fd, 65535, -5, &one, cast<uint>(4)) == 0;
    #c_else
    #c_ifdef FIN_TARGET_DARWIN
    let configured <bool> = kv_setsockopt(fd, 65535, 4, &one, cast<uint>(4)) == 0;
    #c_else
    let configured <bool> = kv_setsockopt(fd, 1, 2, &one, cast<uint>(4)) == 0;
    #c_endif
    #c_endif
    if (!configured) { kv_socket_close(fd); return kv_socket_invalid(); }
    let addr <[int]> = new [int, 4]{};
    #c_ifdef FIN_TARGET_DARWIN
    let family <int> = 528;
    #c_else
    let family <int> = 2;
    #c_endif
    addr[0] = cast<int>(cast<long>(family) + cast<long>(port / 256) * cast<long>(65536) + cast<long>(port % 256) * cast<long>(16777216));
    addr[1] = cast<int>(kv_inet_addr("127.0.0.1"));
    let ok <bool> = kv_bind(fd, &addr[0], cast<uint>(16)) == 0 && kv_listen(fd, 16) == 0;
    let size <uint> = cast<uint>(16);
    if (ok) { ok = kv_sockname(fd, &addr[0], &size) == 0; }
    let word <uint> = cast<uint>(addr[0]);
    *actual = cast<int>(((word / cast<uint>(65536)) % cast<uint>(256)) * cast<uint>(256) + word / cast<uint>(16777216));
    delete addr;
    if (!ok) { kv_socket_close(fd); return kv_socket_invalid(); }
    return fd;
}
fun env_number(name: string, fallback: long, maximum: long) <Number> {
    let text <string> = kv_getenv(name);
    if (text == null) { return Number{valid: true, value: fallback}; }
    return decimal(text, maximum);
}
fun main() <int> {
    let port <Number> = env_number("FIN_KV_PORT", cast<long>(7379), cast<long>(65535));
    let timeout <Number> = env_number("FIN_KV_TIMEOUT_MS", cast<long>(5000), cast<long>(60000));
    if (!port.valid || !timeout.valid || timeout.value == cast<long>(0)) { printf("error: invalid port or timeout\n"); return 1; }
    let store <Store> = make_store();
    let log <Log> = Log{fd: -1, fp: null, end: cast<long>(0), failed: false};
    if (!open_log(&log, &store)) { close_log(&log); free_store(&store); return 1; }
    if (!kv_network_init()) { close_log(&log); free_store(&store); return 1; }
    let actual <int> = 0;
    let listener <KVSocket> = listen_loopback(cast<int>(port.value), &actual);
    if (listener == kv_socket_invalid()) { printf("error: cannot listen\n"); kv_network_close(); close_log(&log); free_store(&store); return 1; }
    printf("fin-kv listening on 127.0.0.1:%d (aof: %s)\n", actual, AOF_PATH);
    kv_fflush(null);
    while (true) {
        let client <KVSocket> = kv_accept(listener, null, null);
        if (client == kv_socket_invalid()) { if (kv_io_interrupted()) { continue; } break; }
        if (kv_prepare_client(client)) { serve_client(client, &store, &log, cast<int>(timeout.value)); }
        kv_socket_close(client);
    }
    kv_socket_close(listener); kv_network_close(); close_log(&log); free_store(&store);
    return 1;
}
